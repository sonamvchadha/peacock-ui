{
  "name": "peacock-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A small demo design system: three-tier design tokens, React components that use tokens only, and Storybook.",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "node scripts/lint-raw-values.mjs",
    "check": "npm run tokens && npm run check:contrast && npm run lint:tokens && npm run typecheck",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build -o storybook-static"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "storybook": "8.6.14",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
